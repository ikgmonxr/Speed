local function createPage(name)
	local page = Instance.new("ScrollingFrame")
	page.Name = name .. "Page"
	page.BackgroundTransparency = 1
	page.BorderSizePixel = 0
	page.Position = UDim2.new(0, 24, 0, 16)
	page.Size = UDim2.new(1, -48, 1, -32)
	page.CanvasSize = UDim2.new(0, 0, 0, 0)
	page.AutomaticCanvasSize = Enum.AutomaticSize.Y
	page.ScrollBarThickness = 3
	page.ScrollBarImageColor3 = Color3.fromRGB(100, 80, 160)
	page.Visible = false
	page.Parent = ContentArea

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 14)
	layout.Parent = page

	pages[name] = page
	return page
end

local function addTabButton(name, displayName, order)
	local btn = Instance.new("TextButton")
	btn.BackgroundColor3 = Color3.fromRGB(20, 18, 32)
	btn.BackgroundTransparency = 1
	btn.Size = UDim2.new(1, 0, 0, 42)
	btn.Font = Enum.Font.GothamMedium
	btn.Text = "  " .. displayName
	btn.TextColor3 = Color3.fromRGB(150, 145, 185)
	btn.TextSize = 13
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.LayoutOrder = order
	btn.AutoButtonColor = false
	btn.Parent = Sidebar
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 9)

	btn.MouseButton1Click:Connect(function()
		for pName, pObj in pairs(pages) do pObj.Visible = (pName == name) end
		for bName, bObj in pairs(tabButtons) do
			if bName == name then
				bObj.BackgroundTransparency = 0.35
				bObj.BackgroundColor3 = Color3.fromRGB(75, 50, 130)
				bObj.TextColor3 = Color3.fromRGB(255, 255, 255)
			else
				bObj.BackgroundTransparency = 1
				bObj.TextColor3 = Color3.fromRGB(150, 145, 185)
			end
		end
	end)
	tabButtons[name] = btn
end


local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
	local method = getnamecallmethod()
	
	if not checkcaller() and getgenv().AstraTargetPart and getgenv().AutoShot.Enabled then
		local target = getgenv().AstraTargetPart
		
		if target and target.Parent then
			local targetPos = target.Position

			-- Predicción
			local hrp = target.Parent:FindFirstChild("HumanoidRootPart")
			if hrp then
				local vel = hrp.AssemblyLinearVelocity
				targetPos = targetPos + (vel * (getgenv().SilentAim.Prediction / 1000))
			end

			if method == "Raycast" and self == Workspace then
				local origin, direction, p3 = ...
				if typeof(direction) == "Vector3" and direction.Magnitude > 15 then
					local newDir = (targetPos - origin).Unit * 9999
					return oldNamecall(self, origin, newDir, p3)
				end
			elseif method:find("FindPartOnRay") and self == Workspace then
				local ray, p2, p3, p4 = ...
				if typeof(ray) == "Ray" and ray.Direction.Magnitude > 15 then
					local newRay = Ray.new(ray.Origin, (targetPos - ray.Origin).Unit * 9999)
					return oldNamecall(self, newRay, p2, p3, p4)
				end
			end
		else
			getgenv().AstraTargetPart = nil
		end
	end

	return oldNamecall(self, ...)
end)

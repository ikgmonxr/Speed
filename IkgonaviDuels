			btn.BackgroundColor3 = Color3.fromRGB(35, 65, 45)
		else
			btn.Text = "OFF"
			btn.TextColor3 = Color3.fromRGB(255, 80, 80)
			btn.BackgroundColor3 = Color3.fromRGB(40, 25, 28)
		end
		callback(newState)
	end)

	return frame

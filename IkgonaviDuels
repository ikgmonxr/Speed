local function getAndEquipTool2()
	local char = LocalPlayer.Character
	if not char then return nil end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid then return nil end

	local equippedTool = char:FindFirstChildOfClass("Tool")
	if equippedTool then return equippedTool end

	local toolsInBackpack = {}
	for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
		if item:IsA("Tool") then
			table.insert(toolsInBackpack, item)
		end
	end

	local targetTool = toolsInBackpack[2] or toolsInBackpack[1]
	if targetTool then
		humanoid:EquipTool(targetTool)
		if targetTool.Parent == char then
			return targetTool
		end
	end
	return nil
end

local function applyNoclip()
	local char = LocalPlayer.Character
	if char then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				part.CanCollide = false
			end
		end
	end
end

local function hasEnoughPlayers()
	return #Players:GetPlayers() >= getgenv().MinPlayersToRun
end

local function isEnemy(p)
	if not p or p == LocalPlayer or not p.Character then return false end

	local myChar = LocalPlayer.Character
	local targetChar = p.Character
	if not myChar or not targetChar then return false end

	local myHRP = myChar:FindFirstChild("HumanoidRootPart")
	local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
	local targetHum = targetChar:FindFirstChildOfClass("Humanoid")

	if not myHRP or not targetHRP or not targetHum or targetHum.Health <= 0 then
		return false
	end

	local dist = (targetHRP.Position - myHRP.Position).Magnitude
	if dist > getgenv().KillAll.MaxDistanceFilter then return false end

	local myAttr = LocalPlayer:GetAttribute("Team")
	local targetAttr = p:GetAttribute("Team")
	if myAttr ~= nil and targetAttr ~= nil then
		return myAttr ~= targetAttr
	end

	if LocalPlayer.Team and p.Team then
		return LocalPlayer.Team ~= p.Team
	end

	return true
end

local function isVisible(targetPart)
	local myChar = LocalPlayer.Character
	if not myChar or not targetPart then return false end

	local myHead = myChar:FindFirstChild("Head") or myChar:FindFirstChild("HumanoidRootPart")
	if not myHead then return false end

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {myChar, targetPart.Parent}
	raycastParams.IgnoreWater = true

	local direction = (targetPart.Position - myHead.Position)
	local result = Workspace:Raycast(myHead.Position, direction, raycastParams)
	return result == nil
end

local function getClosestAbsolute()
	if not hasEnoughPlayers() then return nil, nil end

	local targetPart, targetPlayer = nil, nil
	local closestDist = math.huge

	for _, p in ipairs(Players:GetPlayers()) do
		if isEnemy(p) then
			local char = p.Character
			local hrp = char:FindFirstChild("HumanoidRootPart")
			local part = char:FindFirstChild(getgenv().SilentAim.Part) or char:FindFirstChild("Head") or hrp

			if hrp and part then
				if isVisible(part) then
					local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
					if myHRP then
						local dist = (hrp.Position - myHRP.Position).Magnitude
						if dist < closestDist then
							closestDist = dist
							targetPart = part
							targetPlayer = p
						end
					end
				end
			end
		end
	end
	return targetPart, targetPlayer
end

local function updateChams()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local existing = player.Character:FindFirstChild("Chams_Ikgonavi")
			if getgenv().ESP.Enabled and isEnemy(player) and hasEnoughPlayers() then
				if not existing then
					local highlight = Instance.new("Highlight")
					highlight.Name = "Chams_Ikgonavi"
					highlight.FillColor = Color3.fromRGB(255, 40, 40)
					highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
					highlight.FillTransparency = 0.5
					highlight.OutlineTransparency = 0
					highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					highlight.Parent = player.Character
				end
			else
				if existing then existing:Destroy() end
			end
		end
	end
end

local originalSizes = {}
local function updateHitbox()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local hrp = player.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local activeHitbox = getgenv().Hitbox.Enabled or getgenv().KillAll.Enabled
				local sizeToApply = getgenv().KillAll.Enabled and 25 or getgenv().Hitbox.Size

				if activeHitbox and isEnemy(player) and hasEnoughPlayers() then
					if not originalSizes[hrp] then originalSizes[hrp] = hrp.Size end
					hrp.Size = Vector3.new(sizeToApply, sizeToApply, sizeToApply)
					hrp.Transparency = 0.7
					hrp.CanCollide = false
				else
					if originalSizes[hrp] then
						hrp.Size = originalSizes[hrp]
						hrp.Transparency = 0
						originalSizes[hrp] = nil
					end
				end
			end
		end
	end
end

-- ========== HOOK MEJORADO ==========
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
	local method = getnamecallmethod()

	if not checkcaller() and getgenv().AstraTargetPart and getgenv().AutoShot.Enabled then
		local target = getgenv().AstraTargetPart

		if target and target.Parent then
			local targetPos = target.Position

			-- Predicción
			local hrp = target.Parent:FindFirstChild("HumanoidRootPart")
			if hrp then
				local vel = hrp.AssemblyLinearVelocity
				targetPos = targetPos + (vel * (getgenv().SilentAim.Prediction / 1000))
			end

			if method == "Raycast" and self == Workspace then
				local origin, direction, p3 = ...
				if typeof(direction) == "Vector3" and direction.Magnitude > 15 then
					local newDir = (targetPos - origin).Unit * 9999
					return oldNamecall(self, origin, newDir, p3)
				end
			elseif method:find("FindPartOnRay") and self == Workspace then
				local ray, p2, p3, p4 = ...
				if typeof(ray) == "Ray" and ray.Direction.Magnitude > 15 then
					local newRay = Ray.new(ray.Origin, (targetPos - ray.Origin).Unit * 9999)
					return oldNamecall(self, newRay, p2, p3, p4)
				end
			end
		else
			getgenv().AstraTargetPart = nil
		end
	end

	return oldNamecall(self, ...)
end)

if hookmetamethod then
	local oldIndex
	oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, index)
		if getgenv().SilentAim.Enabled and self == LocalPlayer:GetMouse() and not checkcaller() then
			local targetPart, targetPlayer = getClosestAbsolute()
			if targetPart and targetPlayer and targetPlayer.Character then
				if index == "Hit" then
					local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
					local velocity = hrp and hrp.AssemblyLinearVelocity or Vector3.zero
					local predictedPos = targetPart.Position + (velocity * (getgenv().SilentAim.Prediction / 1000))
					return CFrame.new(predictedPos)
				elseif index == "Target" then
					return targetPart
				end
			end
		end
		return oldIndex(self, index)
	end))
end

local function trackTargetDeath(player)
	if targetDiedConnection then targetDiedConnection:Disconnect() end
	currentTargetPlayer = player

	if player and player.Character then
		local hum = player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			targetDiedConnection = hum.Died:Connect(function()
				if mouse1release then mouse1release() end
				waitingAfterKill = true
				currentTargetPlayer = nil
				debugLog("Objetivo eliminado. Cooldown activo...")
				task.delay(7, function()
					waitingAfterKill = false
					debugLog("Reanudando Kill All...")
				end)

				if targetDiedConnection then targetDiedConnection:Disconnect() end
			end)
		end
	end
end

-- ========== AUTO SHOT MEJORADO ==========
task.spawn(function()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true

	while true do
		task.wait(0.06)

		if not getgenv().AutoShot.Enabled or not hasEnoughPlayers() then
			getgenv().AstraTargetPart = nil
			continue
		end

		local char = LocalPlayer.Character
		if not char or not char:FindFirstChild("HumanoidRootPart") then
			getgenv().AstraTargetPart = nil
			continue
		end

		-- Equipar tool automáticamente
		local arma = char:FindFirstChildOfClass("Tool")
		if not arma then
			arma = getAndEquipTool2()
		end

		if not arma or not arma:FindFirstChild("Handle") then
			getgenv().AstraTargetPart = nil
			continue
		end

		local closestTargetPart = nil
		local shortestDistance = math.huge
		local myPos = char.HumanoidRootPart.Position
		local headPos = (char:FindFirstChild("Head") and char.Head.Position) or myPos

		for _, p in ipairs(Players:GetPlayers()) do
			if isEnemy(p) then
				local enemyChar = p.Character
				local enemyHum = enemyChar and enemyChar:FindFirstChildOfClass("Humanoid")

				if enemyHum and enemyHum.Health > 0 then
					params.FilterDescendantsInstances = {char, enemyChar}

					local function checkPart(part)
						if not part or not part:IsA("BasePart") then return end

						local dist = (part.Position - myPos).Magnitude
						if dist >= shortestDistance then return end

						local size = part.Size
						local offsets = {
							Vector3.zero,
							Vector3.new(size.X * 0.4, 0, 0),
							Vector3.new(-size.X * 0.4, 0, 0),
							Vector3.new(0, size.Y * 0.4, 0),
							Vector3.new(0, -size.Y * 0.35, 0),
							Vector3.new(0, 0, size.Z * 0.4),
							Vector3.new(0, 0, -size.Z * 0.4)
						}

						local visible = false
						for _, offset in ipairs(offsets) do
							local targetPos = (part.CFrame * CFrame.new(offset)).Position
							local dir = targetPos - headPos
							if not Workspace:Raycast(headPos, dir, params) then
								visible = true
								break
							end
						end

						if visible then
							shortestDistance = dist
							closestTargetPart = part
						end
					end

					local priorityParts = {"Head", "HumanoidRootPart", "UpperTorso", "Torso", "LowerTorso"}
					for _, name in ipairs(priorityParts) do
						local part = enemyChar:FindFirstChild(name)
						if part then
							checkPart(part)
						end
					end
				end
			end
		end

		if closestTargetPart and closestTargetPart.Parent then
			getgenv().AstraTargetPart = closestTargetPart

			pcall(function()
				arma:Activate()

				if mouse1press then
					mouse1press()
					task.wait(0.03)
					mouse1release()
				end

				task.delay(0.04, function()
					if arma and arma.Parent == char then
						arma:Deactivate()
					end
				end)
			end)

			task.wait(0.08)
		else
			getgenv().AstraTargetPart = nil
		end
	end
end)

